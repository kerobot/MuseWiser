<Application x:Class="MuseWiser.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MuseWiser"
             xmlns:conv="clr-namespace:MuseWiser.Converters"
             xmlns:tb="clr-namespace:Hardcodet.Wpf.TaskbarNotification;assembly=Hardcodet.NotifyIcon.Wpf">
    <Application.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <conv:LevelSegmentBrushMultiConverter x:Key="LevelSegmentBrushMultiConverter" />
        <conv:SpectrumSegmentBrushMultiConverter x:Key="SpectrumSegmentBrushMultiConverter" />
        <conv:SpectrumPeakSegmentBrushMultiConverter x:Key="SpectrumPeakSegmentBrushMultiConverter" />

        <tb:TaskbarIcon x:Key="TrayIcon" ToolTipText="MuseWiser">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="設定(_S)" Click="SettingsMenuItem_Click" />
                    <Separator />
                    <MenuItem Header="終了(_X)" Click="ExitMenuItem_Click" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Application.Resources>
</Application>
